{
  "name": "dsh-native-browser-bdg",
  "version": "1.0.1",
  "description": "DeepSeek 原生浏览器扩展：复用 DeepSeek Harness 官方侧边栏浏览器，在应用内原生运行，不启动外部 Chrome，无需切屏。",
  "type": "module",
  "license": "MIT",
  "author": "safumo",
  "repository": {
    "type": "git",
    "url": "https://github.com/safumo/dsh-native-browser-bdg.git"
  },
  "homepage": "https://github.com/safumo/dsh-native-browser-bdg#readme",
  "bugs": {
    "url": "https://github.com/safumo/dsh-native-browser-bdg/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "native-browser",
    "sidebar-browser",
    "browser-automation",
    "electron"
  ],
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client.js"
  },
  "meta": {
    "title": "DeepSeek 原生浏览器扩展",
    "description": "复用 DeepSeek Harness 官方侧边栏浏览器；不是外部 Chrome，不需要浏览器扩展，应用内原生运行、无需切屏。"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/dsh-native-browser.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:lib": "npm run build && git diff --exit-code -- lib",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
