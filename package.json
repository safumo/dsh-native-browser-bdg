{
  "name": "dsh-native-browser-bdg",
  "version": "1.0.0",
  "description": "DeepSeek \u539f\u751f\u6d4f\u89c8\u5668\u6269\u5c55\uff1a\u590d\u7528 DeepSeek Harness \u5b98\u65b9\u4fa7\u8fb9\u680f\u6d4f\u89c8\u5668\uff0c\u5728\u5e94\u7528\u5185\u539f\u751f\u8fd0\u884c\uff0c\u4e0d\u542f\u52a8\u5916\u90e8 Chrome\uff0c\u65e0\u9700\u5207\u5c4f\u3002",
  "type": "module",
  "license": "MIT",
  "author": "safumo",
  "repository": {
    "type": "git",
    "url": "https://github.com/safumo/dsh-native-browser-bdg.git"
  },
  "homepage": "https://github.com/safumo/dsh-native-browser-bdg#readme",
  "bugs": {
    "url": "https://github.com/safumo/dsh-native-browser-bdg/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "native-browser",
    "sidebar-browser",
    "browser-automation",
    "electron"
  ],
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client/index.js"
  },
  "meta": {
    "title": "DeepSeek \u539f\u751f\u6d4f\u89c8\u5668\u6269\u5c55",
    "description": "\u590d\u7528 DeepSeek Harness \u5b98\u65b9\u4fa7\u8fb9\u680f\u6d4f\u89c8\u5668\uff1b\u4e0d\u662f\u5916\u90e8 Chrome\uff0c\u4e0d\u9700\u8981\u6d4f\u89c8\u5668\u6269\u5c55\uff0c\u5e94\u7528\u5185\u539f\u751f\u8fd0\u884c\u3001\u65e0\u9700\u5207\u5c4f\u3002"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/dsh-native-browser.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:lib": "npm run build && git diff --exit-code -- lib",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
